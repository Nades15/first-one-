# Copy this file to livebot/.env and fill in real values.
# livebot/.env is gitignored — it must NEVER be committed.

# Solana RPC endpoint. A free Helius key works fine:
#   https://dashboard.helius.dev  ->  create key  ->  copy the https URL
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Base58 secret key of a BURNER wallet used ONLY for this bot.
# NEVER use a wallet that holds anything you care about.
# Fund it with a small amount you are fully prepared to lose.
# Create one with:  solana-keygen new --outfile burner.json   (then export base58)
# or export a private key from Phantom (Settings -> export private key).
WALLET_SECRET_KEY=PUT_YOUR_BURNER_BASE58_SECRET_KEY_HERE

# Local dashboard port (bound to 127.0.0.1 only).
LIVEBOT_PORT=8787
